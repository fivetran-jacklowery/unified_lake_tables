# Copy this file to .env and fill in the values below. .env is gitignored --
# never commit your real credentials.
#
# Only Polaris REST catalog OAuth client-credentials are needed here. No
# AWS access key / secret key belongs in this file, and the scripts in
# this repo never ask for one: Fivetran's Polaris catalog vends short-lived,
# scoped AWS storage credentials automatically when a table is loaded
# (pyiceberg's RestCatalog requests this by default). See
# docs/HOW_IT_WORKS.md, "Credentials: vended, not static" for how this
# actually works and what to do if it doesn't behave as expected.
#
# Where to find these values: in the Fivetran dashboard, open the
# Managed Data Lake Service destination you want to consolidate tables
# in, and look at its catalog / external-access setup page (exact label
# varies by dashboard version -- look for "Polaris", "Iceberg REST
# catalog", or "catalog integration"). That page is where Fivetran
# exposes the catalog URI, warehouse name, and an OAuth client id/secret
# scoped to that destination's catalog. If you can't find it, ask your
# Fivetran account team for the Polaris catalog connection details for
# your MDLS destination.

# Base URI of the Polaris REST catalog, e.g.
# https://<your-account>.fivetranapis.com/polaris/api/catalog
POLARIS_CATALOG_URI=

# OAuth2 token endpoint used to exchange the client id/secret below for a
# bearer token (client-credentials grant), e.g.
# https://<your-account>.fivetranapis.com/polaris/api/catalog/v1/oauth/tokens
#
# Treat this as REQUIRED, not optional, even though pyiceberg 0.11.x will
# still fall back to deriving a token endpoint from POLARIS_CATALOG_URI if
# this is left blank. That fallback is explicitly marked deprecated in
# pyiceberg's own source (catalog/rest/__init__.py) and is scheduled for
# removal in a future release, so relying on it today just means this
# breaks later for no reason. Confirm the exact path with your Fivetran
# contact if it isn't shown on the same dashboard page as the catalog URI.
POLARIS_TOKEN_URI=

# OAuth2 client id and secret for your catalog integration. These
# authenticate this SCRIPT to Polaris -- they are not AWS credentials and
# do not by themselves grant access to any S3 bucket.
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=

# OAuth2 scope requested for the token. PRINCIPAL_ROLE:ALL is Polaris's
# common default for a catalog-integration service principal; use whatever
# scope your Fivetran-provisioned integration actually grants if different.
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL

# Polaris warehouse (catalog) name backing your MDLS destination.
POLARIS_WAREHOUSE=
