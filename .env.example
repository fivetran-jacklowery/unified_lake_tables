# Copy this file to .env and fill in the values below. .env is gitignored --
# never commit your real credentials.
#
# This file holds CREDENTIALS only. What actually gets consolidated -- the
# target namespace, the source namespaces, the bookkeeping column -- lives in
# config.yaml instead. See config.example.yaml for that half.
#
# Where to find these values: in the Fivetran dashboard, open the Managed
# Data Lake Service destination you want to consolidate tables in, and look
# at its catalog / external-access setup page (exact label varies by
# dashboard version -- look for "Polaris", "Iceberg REST catalog", or
# "catalog integration"). That page is where Fivetran exposes the catalog
# URI, warehouse name, and an OAuth client id/secret scoped to that
# destination's catalog. If you can't find it, ask your Fivetran account
# team for the Polaris catalog connection details for your MDLS destination.


# ---------------------------------------------------------------------------
# REQUIRED. The scripts exit immediately if any of these four is missing.
# ---------------------------------------------------------------------------

# Base URI of the Polaris REST catalog, e.g.
# https://<your-account>.fivetranapis.com/polaris/api/catalog
POLARIS_CATALOG_URI=

# Polaris warehouse (catalog) name backing your MDLS destination.
POLARIS_WAREHOUSE=

# OAuth2 client id and secret for your catalog integration. These
# authenticate this SCRIPT to Polaris -- they are not AWS credentials and
# do not by themselves grant access to any S3 bucket.
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# OPTIONAL, but set it anyway.
# ---------------------------------------------------------------------------

# OAuth2 token endpoint used to exchange the client id/secret above for a
# bearer token (client-credentials grant), e.g.
# https://<your-account>.fivetranapis.com/polaris/api/catalog/v1/oauth/tokens
#
# Leave this blank and the run still works: it logs a warning, and pyiceberg
# 0.11.x falls back to deriving a token endpoint from POLARIS_CATALOG_URI.
# That fallback is marked deprecated in pyiceberg's own source
# (catalog/rest/__init__.py) and is scheduled for removal in a future
# release, so leaning on it today just means this breaks later for no
# reason. Confirm the exact path with your Fivetran contact if it isn't
# shown on the same dashboard page as the catalog URI.
POLARIS_TOKEN_URI=


# ---------------------------------------------------------------------------
# OPTIONAL. Defaults shown -- safe to leave exactly as they are.
# ---------------------------------------------------------------------------

# OAuth2 scope requested for the token. PRINCIPAL_ROLE:ALL is Polaris's
# common default for a catalog-integration service principal; use whatever
# scope your Fivetran-provisioned integration actually grants if different.
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL

# Logging verbosity, read by every script in scripts/ and by the Lambda
# handler (DEBUG, INFO, WARNING, ERROR).
#
# These scripts emit only INFO and WARNING records of their own -- there are
# no DEBUG messages in this repo. INFO is what carries the useful detail:
# the resolved source-namespace list, per-table progress, and the splice and
# rewrite decisions behind the final summary. So:
#
#   INFO     the intended setting; leave it here.
#   WARNING  quiets per-table progress down to problems only.
#   DEBUG    adds nothing from this code. It raises the ROOT logger, so what
#            you actually get is third-party chatter -- pyiceberg's REST
#            calls, urllib3, botocore. Noisy, but the right tool when you're
#            debugging catalog auth or vended-credential failures.
LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Deliberately NOT here: AWS credentials.
# ---------------------------------------------------------------------------
#
# Do not add AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN or
# AWS_PROFILE to this file. Fivetran's Polaris catalog vends short-lived,
# scoped AWS storage credentials automatically when a table is loaded
# (pyiceberg's RestCatalog requests this by default), so there is no static
# AWS credential in this picture at all. See docs/HOW_IT_WORKS.md,
# "Credentials: vended, not static".
#
# register_consolidation.py does more than just ignore those four variables:
# it deletes them from its own process environment, once at import and again
# after reading .env. If vending ever fails, you get a loud auth error
# instead of the script quietly reading or writing through whatever ambient
# AWS identity happened to be in scope. Setting them therefore has no effect
# on this script -- it just won't look like it. The import-time purge is
# silent (an attached IAM role is normal and expected when running on
# EC2/ECS/Lambda); only keys found in .env produce a warning saying they
# were dropped.
#
# Two things that follow from this, worth knowing before you debug an auth
# problem:
#
#   - Only register_consolidation.py purges. verify_consolidation.py,
#     bench_vs_union.py and generate_delta_log.py do not, and will happily
#     use ambient AWS credentials if they find any. If verify succeeds while
#     register fails, an ambient identity is the first thing to suspect.
#
#   - The AWS Glue example is the one place static AWS credentials ARE
#     expected, because the Glue Data Catalog has no credential-vending
#     mechanism at all. Those go in examples/aws-glue/.env (see
#     examples/aws-glue/.env.example), never in this file.


# ---------------------------------------------------------------------------
# Not configured here: the AWS Lambda example.
# ---------------------------------------------------------------------------
#
# examples/aws-lambda/lambda_function.py reads neither .env nor config.yaml
# -- a Lambda has no file to read. It takes everything from the function's
# own environment variables instead: the four required POLARIS_* values
# above, plus TARGET_NAMESPACE, exactly one of SOURCE_NAMESPACES
# (comma-separated) or SOURCE_NAMESPACE_PATTERN (glob), and
# SOURCE_ID_COLUMN. TABLE_WORKERS and SOURCE_WORKERS (both default 8) and
# LOG_LEVEL are optional there too. See examples/aws-lambda/README.md.
