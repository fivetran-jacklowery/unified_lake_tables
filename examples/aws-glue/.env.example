# Copy this file to .env and fill it in. .env is gitignored.
#
# Unlike the Polaris original's .env.example, there is no OAuth
# client-id/secret here -- AWS Glue Data Catalog has no credential-vending
# mechanism. This script runs on real, standing AWS credentials, resolved
# by boto3 in this order: explicit keys below (if set) -> named profile
# (if set) -> boto3's own default chain (environment variables already in
# your shell, ~/.aws/credentials, or an attached IAM role if you're
# running this on EC2/ECS/Lambda/CodeBuild/etc, which is the recommended
# path in production -- nothing below needs to be set at all in that case).

# Required: S3 path new tables get created under, e.g.
# s3://your-bucket/warehouse/. Must be writable by whatever credentials
# this script ends up using.
GLUE_WAREHOUSE_PATH=s3://your-bucket/warehouse/

# Optional: only needed for a cross-account Glue catalog (AWS's "Glue
# Catalog ID," typically a 12-digit account id).
GLUE_CATALOG_ID=

# Optional. Leave all of these blank if you're running this somewhere that
# already has an IAM role attached (recommended) -- boto3 will use it
# automatically and nothing below is needed.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
